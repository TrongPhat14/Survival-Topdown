---
title: Survival Top-down - UML Class Diagram
config:
  theme: neutral
  class:
    useMaxWidth: false
---
classDiagram
direction LR

class GameInput {
  <<Singleton>>
  +AttackPressed
  +BlastPressed
  +RepulsePressed
  +GetMovementInputVector2() Vector2
  +DisableGameplayInput()
}

class PlayerController {
  +PlayerDied
  +IsPlayerDead bool
  -HandleDied()
}

class ActorMotor {
  -moveSpeed float
  +SetMoveDirection(Vector3)
}

class ActorFacing {
  -movementTurnSmoothTime float
  +FaceMovementDirection(Vector3)
  +FaceAttackDirection(Vector3)
}

class PlayerTargeting {
  -targetPriority TargetPriority
  -refreshInterval float
  +CurrentTarget Transform
  +TryGetAimDirection(Vector3, Vector3) bool
}

class Health {
  -maxHealth float
  -currentHealth float
  -armor float
  +HealthChanged
  +Damaged
  +Died
  +TakeDamage(float) bool
  +IncreaseHealth(float, float)
  +SetArmor(float)
}

class WeaponController {
  -attackData BasicAttackData
  -currentCharges int
  -damageMultiplier float
  +TryFire() bool
  +CalculateDamage(float) float
  +SetDamageMultiplier(float)
}

class PlayerSkills {
  -bombData BombSkillData
  -dashData DashSkillData
  +TryPlaceBomb() bool
  +TryDash() bool
  +SetDamageMultiplier(float)
}

class PlayerProgression {
  -data ProgressionData
  -totalExperience int
  -currentLevel int
  +AddExperience(int)
}

class DamageCalculator {
  <<static>>
  +CalculatePlayerDamage(float, float) float
}

class Projectile {
  -speed float
  -lifetime float
  -hitLayers LayerMask
  +Launch(Transform, Vector3, float)
  #ApplyHit(Collider) bool
}

class PoisonProjectile {
  -poisonDuration float
  -tickInterval float
  -homingTurnSpeed float
  +LaunchHoming(Transform, Vector3, float, Transform)
  #ApplyHit(Collider) bool
}

class PoisonStatus {
  -poisonRoutine Coroutine
  +ApplyPoison(float, float, float)
}

class ProjectileFactory {
  <<Object Pool>>
  +Register(Projectile, int, int) bool
  +Spawn(Projectile, Transform, Vector3, Quaternion, Vector3, float)
  +Release(Projectile, Projectile)
}

class TimedBomb {
  +Arm(float, float, float, LayerMask)
  -ExplosionRoutine()
}

class AreaDamageUtility {
  <<static>>
  +Apply(Vector3, float, float, LayerMask)
}

class EnemyController {
  -data EnemyData
  -target Transform
  -isAttacking bool
  -isDead bool
  #PerformAttack()
  +PrepareForSpawn(EnemyFactory, EnemyController)
  -AttackRoutine()
  -HandleDied()
}

class RangedEnemyController {
  -muzzle Transform
  -projectilePrefab PoisonProjectile
  #PerformAttack()
}

class EnemyMotor {
  -agent NavMeshAgent
  +Configure(float, float)
  +SetDestination(Vector3) bool
  +Stop()
}

class EnemyFactory {
  <<Object Pool>>
  +EnemyDefeated
  +Register(EnemyController) bool
  +Spawn(EnemyController, Vector3, Quaternion)
  +Release(EnemyController, EnemyController)
}

class WaveController {
  -waves WaveData[]
  -aliveEnemyCount int
  +WaveStarted
  +WaveCompleted
  +AllWavesCompleted
  +StartWaves()
  -RunWaves()
  -SpawnWave(WaveData)
}

class BasicAttackData {
  <<ScriptableObject>>
  +FireInterval float
  +ProjectileCount int
  +SpreadAngle float
  +BaseDamage float
  +AttackRange float
  +ChargeRecoveryDuration float
}

class BombSkillData {
  <<ScriptableObject>>
  +FuseDuration float
  +BaseDamage float
  +ExplosionRadius float
  +Cooldown float
}

class DashSkillData {
  <<ScriptableObject>>
  +Distance float
  +Duration float
  +BaseDamage float
  +ExplosionRadius float
  +Cooldown float
}

class EnemyData {
  <<ScriptableObject>>
  +MaxHealth float
  +MoveSpeed float
  +AttackRange float
  +AttackDamage float
  +ExperienceReward int
}

class ProgressionData {
  <<ScriptableObject>>
  +ExperiencePerLevel int
  +MaxHealthIncrease float
  +ArmorIncrease float
  +GetLevel(int) int
  +GetDamageMultiplier(int) float
}

class WaveData {
  <<ScriptableObject>>
  +SpawnGroups
}

class CombatHUD
class HealthBarUI
class ProgressionHUD
class WaveHUD
class GameResultUI {
  <<Singleton>>
  +Show(GameResult)
  +RestartGame()
}
class DamagePopupEmitter
class DamagePopupPool {
  <<Object Pool>>
}
class DamagePopup
class VfxPool {
  <<Object Pool>>
}
class SoundManager {
  <<Singleton>>
}
class MusicManager {
  <<Singleton>>
}
class CameraShake {
  <<Singleton>>
}

PlayerController *-- ActorMotor
PlayerController *-- ActorFacing
PlayerController *-- Health
PlayerController ..> GameInput : movement
PlayerController ..> GameResultUI : defeat

GameInput ..> WeaponController : attack event
GameInput ..> PlayerSkills : skill events

WeaponController --> BasicAttackData
WeaponController --> DamageCalculator
WeaponController --> ProjectileFactory
WeaponController --> PlayerTargeting
PlayerTargeting --> Health : validates target
ProjectileFactory o-- Projectile
Projectile <|-- PoisonProjectile

PlayerSkills --> BombSkillData
PlayerSkills --> DashSkillData
PlayerSkills --> TimedBomb
PlayerSkills --> AreaDamageUtility
PlayerSkills --> DamageCalculator
TimedBomb --> AreaDamageUtility
TimedBomb --> VfxPool

PoisonProjectile --> PoisonStatus
PoisonStatus --> Health

PlayerProgression --> ProgressionData
PlayerProgression --> WeaponController
PlayerProgression --> PlayerSkills
PlayerProgression --> Health
PlayerProgression ..> EnemyFactory : EnemyDefeated

EnemyController *-- EnemyMotor
EnemyController *-- Health
EnemyController --> EnemyData
EnemyController --> EnemyFactory
EnemyController <|-- RangedEnemyController
RangedEnemyController --> PoisonProjectile
RangedEnemyController --> ProjectileFactory

WaveController --> WaveData
WaveController --> EnemyFactory
WaveController --> WaveHUD
WaveController --> GameResultUI : victory
EnemyFactory o-- EnemyController
EnemyFactory --> VfxPool

CombatHUD --> WeaponController
CombatHUD --> PlayerSkills
HealthBarUI --> Health
ProgressionHUD --> PlayerProgression
DamagePopupEmitter --> Health
DamagePopupEmitter --> DamagePopupPool
DamagePopupPool o-- DamagePopup

Health ..> SoundManager
Health ..> CameraShake
Projectile ..> CameraShake
TimedBomb ..> CameraShake
PlayerController ..> SoundManager
PlayerSkills ..> SoundManager
PlayerProgression ..> SoundManager
GameResultUI ..> SoundManager

